generator bun {
  provider = "go run main.go"
  output   = "../model"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @default(USER)
}

enum Role {
  USER
  ADMIN
}
